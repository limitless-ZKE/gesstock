# Fins de ligne normalisées dans le dépôt quel que soit le poste (Windows, Linux, CI).
* text=auto
/mvnw text eol=lf
*.cmd text eol=crlf
*.sh text eol=lf
# Les migrations Flyway restent identiques d'un poste à l'autre.
*.sql text eol=lf

# Scripts et modes d'emploi du kit de livraison : fins de ligne Windows, identiques sur tous les postes.
*.ps1 text eol=crlf
scripts/kit-livraison/*.txt text eol=crlf
scripts/livraison-simple/*.txt text eol=crlf
scripts/android/*.txt text eol=crlf

# Application Android : lanceur Gradle (sh pour Linux et la CI, bat pour Windows) et son archive.
/android/gradlew text eol=lf
*.bat text eol=crlf
*.jar binary

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:importantForAccessibility="no"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/app_name"
            android:textColor="@color/texte"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/etiquette"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:labelFor="@id/adresse"
            android:text="@string/adresse_titre"
            android:textColor="@color/texte"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/adresse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:minHeight="52dp"
            android:singleLine="true"
            android:textColor="@color/texte"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/adresse_aide"
            android:textColor="@color/texte_doux"
            android:textSize="14sp" />

        <Button
            android:id="@+id/connecter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/vert"
            android:minHeight="52dp"
            android:text="@string/adresse_connecter"
            android:textAllCaps="false"
            android:textColor="@color/blanc"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/attente"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/vert"
            android:visibility="gone" />

        <TextView
            android:id="@+id/message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/texte"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/enregistrer_quand_meme"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="52dp"
            android:text="@string/adresse_enregistrer_quand_meme"
            android:textAllCaps="false"
            android:textColor="@color/vert"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/vue"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/chargement"
        style="@android:style/Widget.Material.Light.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="top"
        android:max="100"
        android:progressTint="@color/vert"
        android:visibility="gone" />

    <!-- Par-dessus la page quand le serveur ne répond pas : ce qu'il faut vérifier, et de quoi réessayer. -->
    <ScrollView
        android:id="@+id/erreur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fond"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/erreur_titre"
                android:textColor="@color/texte"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/erreur_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/texte_doux"
                android:textSize="16sp" />

            <Button
                android:id="@+id/reessayer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:backgroundTint="@color/vert"
                android:minHeight="52dp"
                android:text="@string/reessayer"
                android:textAllCaps="false"
                android:textColor="@color/blanc"
                android:textSize="16sp" />

            <Button
                android:id="@+id/changer_adresse"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="52dp"
                android:text="@string/changer_adresse"
                android:textAllCaps="false"
                android:textColor="@color/vert"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
